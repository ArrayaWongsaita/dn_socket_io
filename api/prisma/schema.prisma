// Prisma schema: describes our 3 tables.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// A person who can use the app (we create these in prisma/seed.ts)
model User {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  messages Message[]
}

// A chat room people can join
model Room {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  messages Message[]
}

// One chat message written by a user in a room
model Message {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())
  userId    Int
  roomId    Int
  user      User     @relation(fields: [userId], references: [id])
  room      Room     @relation(fields: [roomId], references: [id])
}
